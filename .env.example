# Только HTTP localhost: действующие секреты сюда не записывать.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=
# Только для первичной инициализации PostgreSQL, приложению не передаётся.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
